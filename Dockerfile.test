# 基础镜像：轻量级Python 3.13
FROM python:3.13-slim

WORKDIR /app

# 替换为阿里云 Debian 源（适用于 Debian trixie 或 bookworm，根据你的基础镜像版本）
RUN sed -i 's/deb.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list.d/debian.sources 2>/dev/null || \
    sed -i 's/deb.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list

# 安装curl
RUN apt-get update && apt-get install -y curl

# 装uv
RUN pip install uv

# 复制依赖定义
COPY pyproject.toml uv.lock ./

# 安装依赖
RUN uv sync

# 复制测试代码和数据
COPY Web_Automation/shop_api_client.py ./
COPY Web_Automation/test_shop_po.py ./
COPY test_data/ ./test_data/

# 设置环境变量：测试容器通过docker网络访问后端
ENV BASE_URL=http://api:5000

# 容器启动时自动跑测试
CMD ["uv", "run", "pytest", "test_shop_po.py", "-v", "--alluredir=./allure-results"]
